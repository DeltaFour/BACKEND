# String de conexão com o banco de dados MySQL
CONNECTION_STRING="Server=localhost;DataBase=<nome_do_banco>;Uid=<usuario>;Pwd=<senha>"

# Define se o ambiente está em modo de teste (true/false)
IS_TESTING=false

# Configurações de validação do JWT
VALIDATE_LIFETIME=false
REQUIRE_EXPIRATION_TIME=false
VALIDATE_ISSUER_SIGNING_KEY=false
VALIDATE_ISSUER=false
VALIDATE_AUDIENCE=false

# Caminho para os scripts Python usados no reconhecimento facial
FUNCTION_PYTHON_PATH=C:\\caminho

# URL base da API de reconhecimento facial
FACE_RECOGNITION_BASE_URL="http://localhost:8000"

# API-key usada pela API Python (K-Means) para autenticar nos endpoints
# /api/v1/punctuality-metrics/export e /classification.
# Deve ser igual ao API_KEY definido no docker-compose da API-KMEANS.
KMEANS_API_KEY="<chave_secreta_kmeans>"

# Host permitido no CORS (frontend)
ALLOWED_HOST="http://localhost:5173"

# Dados do super administrador (usado para criar o primeiro usuário no sistema)
SUPER_ADMIN_EMAIL="<email_do_super_admin>"
SUPER_ADMIN_NAME="<nome_do_super_admin>"
SUPER_ADMIN_COMPANY_CNPJ="<cnpj_da_empresa_do_super_admin>"
SUPER_ADMIN_COMPANY_NAME="<nome_da_empresa_do_super_admin>"
SUPER_ADMIN_PASSWORD="<senha_do_super_admin>"
SUPER_ADMIN_ID="<guid_do_super_admin>"
ROLE_SUPER_ADMIN_ID="<guid_da_role_super_admin>"

# Configurações de envio de e-mail (SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USERNAME="<usuario_smtp>"
EMAIL_PASSWORD="<senha_smtp>"
EMAIL_FROM_EMAIL="<email_remetente>"
EMAIL_FROM_NAME="DeltaFour"

# Configurações do Stripe (assinaturas)
STRIPE_SECRET_KEY="<stripe_secret_key>"
STRIPE_WEBHOOK_SECRET="<stripe_webhook_secret>"
STRIPE_PRICE_ID="<stripe_price_id>"
STRIPE_SUCCESS_URL="http://localhost:5173/v1/login?payment=true"
STRIPE_CANCEL_URL="http://localhost:5173/stripe/cancel"
